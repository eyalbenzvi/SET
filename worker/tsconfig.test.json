{
  // The integration suite runs in Node (it drives a real `wrangler dev`), so it
  // needs Node globals rather than the Workers runtime typings used by `src/`.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["test/**/*.ts", "vitest.config.ts"]
}
