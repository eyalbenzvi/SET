{
  "name": "set-multiplayer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time multiplayer SET card game: static frontend (GitHub Pages) + Cloudflare Worker/Durable Object backend.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "worker",
    "frontend",
    "e2e"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace shared && npm run test --workspace frontend",
    "test:unit": "npm run test --workspace shared",
    "test:frontend": "npm run test --workspace frontend",
    "test:e2e": "npm run test --workspace e2e",
    "build": "npm run build --workspace frontend",
    "dev": "npm run dev --workspace frontend",
    "dev:worker": "npm run dev --workspace worker",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
